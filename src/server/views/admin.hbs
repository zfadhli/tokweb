<header class="page-head">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>Settings</h1>
    <p class="page-sub">Capture defaults, paths, network, and what this machine is doing right now.</p>
  </div>
</header>

<div class="admin-page">
  <div class="split">
    <div>{{> settings-form}}</div>
    <div class="stack">
      <section class="panel" aria-label="System">
        <div class="panel-head">
          <div>
            <p class="eyebrow">Machine</p>
            <h2>System</h2>
          </div>
        </div>
        <div class="panel-body">
          <dl class="meta-grid">
            {{#each system.items}}
            <div>
              <dt>{{label}}</dt>
              <dd>{{value}}</dd>
            </div>
            {{/each}}
          </dl>
          <p class="hint admin-note">State file: data/state.json, plaintext, local only.</p>
        </div>
      </section>
    </div>
  </div>

  <section class="panel admin-storage" aria-label="Storage">
    <div class="panel-head">
      <div>
        <p class="eyebrow">Disk</p>
        <h2>Storage by user</h2>
      </div>
      <span class="counter">largest first</span>
    </div>
    <div class="panel-body">
      {{#if storage.length}}
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Handle</th>
              <th scope="col" class="align-right">Files</th>
              <th scope="col" class="align-right">Size</th>
              <th scope="col">Share</th>
              <th scope="col" class="align-right">Duration</th>
            </tr>
          </thead>
          <tbody>
            {{#each storage}}
            <tr>
              <td><strong>@{{handle}}</strong></td>
              <td class="num">{{files}}</td>
              <td class="num">{{bytes}}</td>
              <td><span class="storage-bar"><span style="width: {{pct}}%"></span></span></td>
              <td class="num">{{duration}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      {{> empty title="No stored footage yet." hint="Finished captures group here by handle."}}
      {{/if}}
    </div>
  </section>
</div>
