<header class="page-head">
  <div>
    <p class="eyebrow">Watch</p>
    <h1>Users</h1>
    <p class="page-sub">Creators on watch. New additions start polling on the next interval.</p>
  </div>
</header>

<div x-data="{ filter: 'all' }" class="watch-page">
  <div id="users-panel" hx-get="/partials/users" hx-trigger="refreshUsers from:body, every 3s" hx-swap="innerMorph" hx-target="this">
    {{> users}}
  </div>
</div>
