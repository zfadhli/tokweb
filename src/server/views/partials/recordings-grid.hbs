{{#if rows.length}}
<div class="capture-grid is-recordings">
  {{#each rows}}
  <article class="capture is-card" data-search="{{search}}" data-state="{{bucket}}" x-show="(state === 'all' || state === '{{bucket}}') && $el.dataset.search.includes(q.toLowerCase())">
    <a class="capture-link" href="/recordings/{{id}}">
      <span class="capture-art">
        <span class="capture-initial" aria-hidden="true">{{initial}}</span>
        {{#if thumb}}<img class="capture-thumb" src="/api/recordings/{{id}}/thumb" alt="" loading="lazy" decoding="async" onerror="this.remove()" />{{/if}}
        <span class="capture-format">{{duration}}</span>
        <span class="capture-status"><span class="{{chipClass}}">{{chipLabel}}</span></span>
        {{#if playable}}<span class="capture-play"><svg class="icon" aria-hidden="true"><use href="#i-play" /></svg></span>{{/if}}
      </span>
      <span class="capture-body">
        <strong class="capture-handle">@{{handle}}</strong>
        <span class="capture-title">{{title}}</span>
        <span class="capture-meta">{{date}} · {{bytes}}</span>
      </span>
    </a>
    <div class="capture-actions">
      {{#if hasFile}}
      <a class="btn btn-small btn-ghost" href="/api/recordings/{{id}}/download" aria-label="Download @{{handle}}">
        <svg class="icon" aria-hidden="true"><use href="#i-download" /></svg>
      </a>
      {{/if}}
      <button class="icon-btn is-danger" type="button" aria-label="Delete @{{handle}}" hx-delete="/recordings/{{id}}" hx-confirm="{{deleteConfirm}}" hx-swap="none"{{#unless deletable}} disabled title="{{deleteTitle}}"{{/unless}}>
        <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
      </button>
    </div>
  </article>
  {{/each}}
</div>
{{else}}
{{> empty title="No recordings yet." hint="Captures land here once a watch user goes live with auto-record on."}}
{{/if}}
