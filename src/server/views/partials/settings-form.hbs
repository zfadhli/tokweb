<div id="settings-panel" class="panel">
  <div class="panel-head">
    <div>
      <p class="eyebrow">Defaults</p>
      <h2>Capture settings</h2>
    </div>
  </div>
  <div class="panel-body">
    {{#if notice}}<p class="notice">{{notice}}</p>{{/if}}
    <form hx-put="/admin/settings" hx-target="#settings-panel" hx-swap="outerHTML" hx-disable="find button">
      <h3 class="admin-group">Capture defaults</h3>
      <div class="form-grid">
        <div class="field span-2">
          <label for="set-variant">Default quality</label>
          <select class="select" id="set-variant" name="defaultVariant">
            {{#each settings.variants}}
            <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="field">
          <label for="set-interval">Default poll in minutes</label>
          <input class="input" id="set-interval" name="defaultIntervalMin" type="number" min="1" step="1" value="{{minutes.interval}}" />
        </div>
        <div class="field">
          <label for="set-max">Default max segment in minutes, 0 = unlimited</label>
          <input class="input" id="set-max" name="defaultMaxDurationMin" type="number" min="0" step="1" value="{{minutes.maxDuration}}" placeholder="unlimited" />
        </div>
        <div class="field span-2">
          <label for="set-bitrate">Re-encode bitrate</label>
          <input class="input" id="set-bitrate" name="bitrate" type="text" value="{{settings.bitrate}}" placeholder="blank = stream copy" />
        </div>
      </div>
      <h3 class="admin-group">Paths</h3>
      <div class="form-grid">
        <div class="field span-2">
          <label for="set-outdir">Output directory</label>
          <input class="input" id="set-outdir" name="outputDir" type="text" value="{{settings.outputDir}}" autocomplete="off" />
        </div>
        <div class="field span-2">
          <label for="set-ffmpeg">ffmpeg path</label>
          <input class="input" id="set-ffmpeg" name="ffmpegPath" type="text" value="{{settings.ffmpegPath}}" autocomplete="off" />
        </div>
      </div>
      <h3 class="admin-group">Network</h3>
      <div class="form-grid">
        <div class="field">
          <label for="set-proxy">Proxy</label>
          <input class="input" id="set-proxy" name="proxy" type="text" value="{{settings.proxy}}" autocomplete="off" placeholder="blank = direct" />
        </div>
        <div class="field">
          <label for="set-ua">User agent override</label>
          <input class="input" id="set-ua" name="userAgent" type="text" value="{{settings.userAgent}}" autocomplete="off" placeholder="blank = default" />
        </div>
        <div class="field span-2">
          <label for="set-cookies">Cookies</label>
          <textarea class="textarea" id="set-cookies" name="cookies" rows="4" autocomplete="off" placeholder="paste cookies here"></textarea>
          {{#if settings.hasCookies}}<span class="hint">Status: saved. Pasting text replaces the saved value.</span>{{else}}<span class="hint">Status: not set.</span>{{/if}}
        </div>
        <div class="field span-2">
          <input type="hidden" name="clearCookies" value="" />
          <label class="check"><input type="checkbox" name="clearCookies" value="1" /><span class="check-box" aria-hidden="true"></span>Clear saved cookies</label>
        </div>
      </div>
      <h3 class="admin-group">Options</h3>
      <div class="form-grid">
        <div class="field span-2">
          <input type="hidden" name="keepSource" value="off" />
          <label class="check"><input type="checkbox" name="keepSource" value="on"{{#if settings.keepSource}} checked{{/if}} /><span class="check-box" aria-hidden="true"></span>Keep intermediate TS capture</label>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save settings</button>
      </div>
    </form>
  </div>
</div>
