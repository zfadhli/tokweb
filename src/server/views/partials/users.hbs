{{#if notice}}<p class="notice is-error">{{notice}}</p>{{/if}}
<div class="watch-tools">
<form class="add-form" hx-post="/watch" hx-target="#users-panel" hx-swap="outerHTML" hx-disable="find button">
  <div class="field">
    <label for="watch-target">Username, live URL, or room id</label>
    <div class="add-row">
      <input class="input" id="watch-target" name="target" type="text" autocomplete="off" placeholder="@creator or https://tiktok.com/@creator/live" />
      <button class="btn btn-primary" type="submit">Add user</button>
    </div>
  </div>
</form>
</div>
{{#if total}}
<div class="watch-grid">
  {{#each columns}}
  <section class="watch-column">
    <header class="watch-column-head"><h2>{{label}}</h2><span class="count">{{count}}</span></header>
    {{#if rows.length}}
    {{#each rows}}
    <article class="watch-card">
      <div class="watch-card-head">
        <span class="user-cell">
          <span class="avatar" aria-hidden="true">{{#if avatarUrl}}<img src="{{avatarUrl}}" alt="" />{{else}}{{initial}}{{/if}}</span>
          <span class="cell-main">
            <strong>@{{handle}}</strong>
            <span>{{title}}</span>
          </span>
        </span>
        <span class="{{chipClass}}">{{#if dot}}<span class="status-dot {{dotClass}}" aria-hidden="true"></span>{{/if}}{{status}}</span>
      </div>
      <div class="watch-card-foot">
        <label class="check"><input type="checkbox" name="autoRecord"{{#if autoRecord}} checked{{/if}} aria-label="Auto-record @{{handle}}" hx-patch="/watch/{{id}}" hx-trigger="change" hx-include="this" hx-swap="none" /><span class="check-box" aria-hidden="true"></span>Auto</label>
        <span class="row-actions">
          <button class="btn btn-small btn-ghost" type="button" hx-post="/watch/{{id}}/check" hx-swap="none">Check</button>
          {{#if isRecording}}
          <button class="btn btn-small" type="button" hx-post="/watch/{{id}}/stop" hx-swap="none">Stop</button>
          {{else}}
          <button class="btn btn-small" type="button" hx-post="/watch/{{id}}/record" hx-swap="none">Record</button>
          {{/if}}
          <button class="icon-btn is-danger" type="button" aria-label="Remove @{{handle}}" hx-delete="/watch/{{id}}" hx-confirm="{{confirm}}" hx-swap="none">
            <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
          </button>
        </span>
      </div>
    </article>
    {{/each}}
    {{else}}
    <p class="watch-column-empty">None</p>
    {{/if}}
  </section>
  {{/each}}
</div>
{{else}}
{{> empty title="No users on watch." hint="Add a creator above. Polling starts on the next interval."}}
{{/if}}
