{{#if rows.length}}
<div class="table-wrap">
  <table class="data">
    <thead>
      <tr>
        <th scope="col">Recording</th>
        <th scope="col">Started</th>
        <th scope="col">Duration</th>
        <th scope="col">Size</th>
        <th scope="col">State</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr x-show="(state === 'all' || state === '{{bucket}}') && $el.dataset.search.includes(q.toLowerCase())" data-search="{{search}}" data-state="{{bucket}}">
        <td>
          <span class="user-cell">
            <span class="avatar" aria-hidden="true">{{initial}}</span>
            <span class="cell-main">
              <strong>@{{handle}}</strong>
              <span>{{title}}</span>
              <span class="mono">{{fileName}}</span>
            </span>
          </span>
        </td>
        <td>{{date}}</td>
        <td>{{duration}}</td>
        <td class="num">{{bytes}}</td>
        <td><span class="{{chipClass}}">{{chipLabel}}</span></td>
        <td>
          <span class="row-actions">
            {{#if playable}}
            <a class="btn btn-small btn-ghost" href="/recordings/{{id}}" aria-label="Play @{{handle}}">
              <svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>
            </a>
            {{/if}}
            {{#if hasFile}}
            <a class="btn btn-small btn-ghost" href="/api/recordings/{{id}}/download" aria-label="Download @{{handle}}">
              <svg class="icon" aria-hidden="true"><use href="#i-download" /></svg>
            </a>
            {{/if}}
            <button class="icon-btn is-danger" type="button" aria-label="Delete @{{handle}}" hx-delete="/recordings/{{id}}" hx-confirm="{{deleteConfirm}}" hx-swap="none"{{#unless deletable}} disabled title="{{deleteTitle}}"{{/unless}}>
              <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
            </button>
          </span>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
{{> empty title="No recordings yet." hint="Captures land here once a watch user goes live with auto-record on."}}
{{/if}}
