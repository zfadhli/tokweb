<header class="page-head">
  <div>
    <p class="eyebrow">Archive</p>
    <h1>Recordings</h1>
    <p class="page-sub">Every capture on this machine, newest first.</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost" type="button" hx-post="/recordings/rescan" hx-swap="none" title="Scan the output folder for files added or deleted outside the app">
      <svg class="icon" aria-hidden="true"><use href="#i-refresh" /></svg>
      Rescan
    </button>
  </div>
</header>

<div x-data="{ q: '', state: 'all' }" class="recordings-page">
  <section class="stats" aria-label="Archive totals">
    {{#each stats}}
    <article class="stat{{#if (eq kind 'hot')}} is-hot{{/if}}">
      <span class="stat-label">{{label}}</span>
      <strong class="stat-value">{{value}}</strong>
      <span class="stat-note">{{note}}</span>
    </article>
    {{/each}}
  </section>

  <section class="panel">
    <div class="panel-head recordings-toolbar">
      <div class="recordings-search">
        <input class="input" type="search" placeholder="Search handle or title" aria-label="Search recordings" x-model="q" />
      </div>
      <div class="filter-row" role="group" aria-label="Filter recordings">
        <button type="button" class="btn btn-small" :class="{ 'is-active': state === 'all' }" @click="state = 'all'" :aria-pressed="state === 'all'">All ({{counts.all}})</button>
        <button type="button" class="btn btn-small" :class="{ 'is-active': state === 'completed' }" @click="state = 'completed'" :aria-pressed="state === 'completed'">Completed ({{counts.completed}})</button>
        <button type="button" class="btn btn-small" :class="{ 'is-active': state === 'failed' }" @click="state = 'failed'" :aria-pressed="state === 'failed'">Failed ({{counts.failed}})</button>
        <button type="button" class="btn btn-small" :class="{ 'is-active': state === 'active' }" @click="state = 'active'" :aria-pressed="state === 'active'">In progress ({{counts.active}})</button>
      </div>
    </div>
    <div id="recordings-panel" hx-get="/partials/recordings" hx-trigger="refreshRecordings from:body, every 5s" hx-swap="innerMorph" hx-target="this">
      {{> recordings-grid}}
    </div>
  </section>
</div>
